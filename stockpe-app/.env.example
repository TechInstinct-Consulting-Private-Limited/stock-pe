# Use your computer's LAN IP when testing with Expo Go on a physical phone.
# Android Emulator can use: http://10.0.2.2:5000/api
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
# MSG91 SendOTP widget credentials (from control.msg91.com -> OTP -> your widget).
# Enable "Mobile Integration" on the widget for the React Native SDK to work.
EXPO_PUBLIC_MSG91_WIDGET_ID=your_widget_id_here
EXPO_PUBLIC_MSG91_TOKEN_AUTH=your_auth_token_here
