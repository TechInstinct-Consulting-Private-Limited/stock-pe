PORT=5000
NODE_ENV=development

# Local PostgreSQL settings. Do not commit your real .env file.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockpe_db
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgres_password
DB_SSL=false

# Use a long, random value in production.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# OTP delivery. Use console only for local development without sending SMS.
OTP_PROVIDER=exotel

# Exotel credentials are available under Dashboard -> Settings -> API Settings.
EXOTEL_API_KEY=replace_with_your_api_key
EXOTEL_API_TOKEN=replace_with_your_api_token
EXOTEL_ACCOUNT_SID=replace_with_your_account_sid
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_SMS_FROM=replace_with_your_approved_sender_id
EXOTEL_DLT_ENTITY_ID=replace_with_your_dlt_entity_id
EXOTEL_DLT_TEMPLATE_ID=replace_with_your_dlt_template_id
# This must exactly match the approved DLT template, with {{otp}} as its variable.
EXOTEL_SMS_TEMPLATE=Your StockPE verification code is {{otp}}. Do not share it. - StockPE
EXOTEL_REQUEST_TIMEOUT_MS=10000
