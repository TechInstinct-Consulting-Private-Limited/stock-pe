PORT=5000
NODE_ENV=development
# Staging review only: fixed OTP works exclusively for the listed test mobiles.
# Never set either value in production.
REVIEW_TEST_OTP=
REVIEW_TEST_MOBILES=

# Local PostgreSQL settings. Do not commit your real .env file.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockpe_db
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgres_password
DB_SSL=false

# Use a long, random value in production.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# OTP delivery. Use console only for local development without sending SMS.
OTP_PROVIDER=exotel

# Exotel credentials are available under Dashboard -> Settings -> API Settings.
EXOTEL_API_KEY=replace_with_your_api_key
EXOTEL_API_TOKEN=replace_with_your_api_token
EXOTEL_ACCOUNT_SID=replace_with_your_account_sid
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_SMS_FROM=replace_with_your_approved_sender_id
EXOTEL_DLT_ENTITY_ID=replace_with_your_dlt_entity_id
EXOTEL_DLT_TEMPLATE_ID=replace_with_your_dlt_template_id
# This must exactly match the approved DLT template, with {{otp}} as its variable.
EXOTEL_SMS_TEMPLATE=Your StockPE verification code is {{otp}}. Do not share it. - StockPE
EXOTEL_REQUEST_TIMEOUT_MS=10000

# Aadhaar KYC provider. The mock provider needs no additional configuration.
AADHAAR_KYC_PROVIDER=mock

# Sandbox.co.in Aadhaar OTP KYC. Keep real values only in the local .env or
# the server secret store; never commit them or expose them to the mobile app.
# Set AADHAAR_KYC_PROVIDER=sandbox_coin only after these credentials and Aadhaar
# oKYC access have been confirmed for the target environment.
SANDBOX_API_KEY=replace_with_sandbox_api_key
SANDBOX_API_SECRET=replace_with_sandbox_api_secret
SANDBOX_BASE_URL=https://api.sandbox.co.in

# Digital-asset payments stay disabled until an approved provider adapter and
# sandbox credentials are configured. Never place production secrets in Git.
DIGITAL_ASSET_PROVIDER=unconfigured
DIGITAL_ASSET_NETWORK=TRC20
DIGITAL_ASSET_WEBHOOK_SECRET=replace_with_provider_webhook_secret

# Local/demo environment only. Never enable this in production and never use a
# real wallet or real USDT with it. It provides deterministic simulated events.
# DIGITAL_ASSET_PROVIDER=mock-trc20
# MOCK_TRC20_ENABLED=true
# MOCK_TRC20_WEBHOOK_SECRET=replace_with_a_long_random_mock_webhook_secret
