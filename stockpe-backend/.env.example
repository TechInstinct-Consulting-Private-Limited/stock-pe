PORT=5000
NODE_ENV=development

# Local PostgreSQL settings. Do not commit your real .env file.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockpe_db
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgres_password
DB_SSL=false

# Use a long, random value in production.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
